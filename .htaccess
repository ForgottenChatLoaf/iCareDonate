# Apache configuration for iCareDonate
Options -Indexes
ServerSignature Off

# ── CRITICAL: Pass Authorization header to PHP (Bearer token auth) ──────────
# Apache strips Authorization by default. This rule forwards it so that
# $_SERVER['HTTP_AUTHORIZATION'] is populated in all PHP API endpoints.
RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Also set REDIRECT_HTTP_AUTHORIZATION for some PHP-CGI setups
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=REDIRECT_HTTP_AUTHORIZATION:%1]

# Directory Index: prefer index.php, then index.html
DirectoryIndex index.php index.html

# Deny access to sensitive files and all SQL scripts
<FilesMatch "^(\.env|\.git|composer\.json|package\.json|.*\.sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block direct web access to CLI-only utility scripts
<IfModule mod_authz_core.c>
    <Directory "scripts">
        Require all denied
    </Directory>
</IfModule>
<IfModule !mod_authz_core.c>
    <Location "/scripts">
        Order allow,deny
        Deny from all
    </Location>
</IfModule>

# Enable UTF-8 encoding
AddDefaultCharset UTF-8

# Custom error pages (PHP application)
# NOTE FOR LOCAL XAMPP: If running under /CommunityDono/ subfolder, Apache's
# ErrorDocument requires a server-absolute path. Uncomment the LOCAL lines and
# comment out the PRODUCTION lines below before local testing.
#
# LOCAL (XAMPP subfolder):
# ErrorDocument 404 /CommunityDono/pages/404.php
# ErrorDocument 403 /CommunityDono/pages/403.php
#
# PRODUCTION (domain root — use these on shared hosting):
ErrorDocument 404 /pages/404.php
ErrorDocument 403 /pages/403.php

