
# Apache configuration for iCareDonate
Options -Indexes
ServerSignature Off

# Pass the Authorization header to PHP for Bearer token authentication
RewriteEngine On

RewriteCond %{HTTP:Authorization} ^(.*)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Support some PHP-CGI setups
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=REDIRECT_HTTP_AUTHORIZATION:%1]

# Default page
DirectoryIndex index.php index.html

# Deny access to sensitive files and SQL scripts
<FilesMatch "(?i)^(\.env|composer\.json|package\.json|.*\.sql)$">
    Require all denied
</FilesMatch>

# Block requests to Git metadata and environment files
RewriteRule (^|/)\.git(?:/|$) - [F,L,NC]
RewriteRule (^|/)\.env$ - [F,L,NC]

# UTF-8 encoding
AddDefaultCharset UTF-8

# Custom error pages for local XAMPP
ErrorDocument 404 /CommunityDono/pages/404.php
ErrorDocument 403 /CommunityDono/pages/403.php
