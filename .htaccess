# Apache configuration for iCareDonate
Options -Indexes
ServerSignature Off

# ── CRITICAL: Pass Authorization header to PHP (Bearer token auth) ──────────
# Apache strips Authorization by default. This rule forwards it so that
# $_SERVER['HTTP_AUTHORIZATION'] is populated in all PHP API endpoints.
RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Also set REDIRECT_HTTP_AUTHORIZATION for some PHP-CGI setups
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=REDIRECT_HTTP_AUTHORIZATION:%1]

# Directory Index: prefer index.php, then index.html
DirectoryIndex index.php index.html

# Deny access to sensitive files and all SQL scripts
<FilesMatch "^(\.env|\.git|composer\.json|package\.json|.*\.sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable UTF-8 encoding
AddDefaultCharset UTF-8

# Custom error pages (PHP application)
ErrorDocument 404 /pages/404.php
ErrorDocument 403 /pages/403.php

