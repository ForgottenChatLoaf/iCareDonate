# =============================================================
# iCareDonate - .gitignore
# =============================================================

# ----- Local scratch and temporary scripts -------------------
scratch/

# ----- Environment files and secrets -------------------------
.env
*.local
*.env.local
*.env.*.local

# ----- Local uploads (user-submitted files) ------------------
# Keeps the folder structure tracked without committing uploaded files
uploads/**
!uploads/
!uploads/.gitkeep
!uploads/donations/
!uploads/donations/.gitkeep
!uploads/private/
!uploads/private/.gitkeep
!uploads/private/proofs/
!uploads/private/proofs/.gitkeep

# ----- Logs and debug output ---------------------------------
*.log
logs/
php_errors.log

# ----- Composer / vendor dependencies ------------------------
vendor/
composer.lock

# ----- OS-generated files ------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----- Editor and IDE files ----------------------------------
.vscode/
.idea/
*.swp
*.swo
*.kate-swp

# ----- Windows line-ending artefacts -------------------------
*.orig

# ----- Local backup archives (never commit) ------------------
backend-archive/
*-backup/
*-bak/
