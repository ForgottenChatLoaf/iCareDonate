# iCareDonate — .gitignore

# ── Environment & Secrets ────────────────────────────
.env
.env.*
*.env
!.env.example
aiven-ca.pem
run_migration.php
test_conn.php

# ── Operating System Clutter ─────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
[Dd]esktop.ini
*.stackdump
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Editor & IDE Artifacts ───────────────────────────
.vscode/*
!.vscode/settings.json.example
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Logs & Temporary Files ───────────────────────────
*.log
logs/
*.tmp
*.temp
tmp/
temp/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Local Session & Server Runtime ───────────────────
sess_*
*.pid
*.seed

# ── Dependencies ─────────────────────────────────────
node_modules/
vendor/

# ── Local Database Dumps & Backups ───────────────────
# Exclude private data dumps and backups while preserving versioned schema definitions
*.bak
*.backup
*.dump
*.sql.gz
*.sql.bak
backup/
backups/

transcript.txt

# ── Old Docs & Archived Files (not tracked) ──────────
docs/
archived/
