# iCareDonate — Environment Variable Template
# Copy this to .env for local development (never commit .env itself)
# On Render, set these directly in the Environment dashboard

APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-service-name.onrender.com

DB_HOST=your-mysql-private-hostname.render.com
DB_PORT=3306
DB_DATABASE=icaredonate_prod
DB_USERNAME=icaredonate_app
DB_PASSWORD=your_strong_password_here
