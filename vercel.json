{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/login.php", "destination": "/login.html", "permanent": false },
    { "source": "/logout.php", "destination": "/logout.html", "permanent": false },
    { "source": "/signup.php", "destination": "/signup.html", "permanent": false },
    { "source": "/admin", "destination": "/admin/index.html", "permanent": false },
    { "source": "/admin/", "destination": "/admin/index.html", "permanent": false },
    { "source": "/admin/index.php", "destination": "/admin/index.html", "permanent": false },
    { "source": "/user", "destination": "/user/dashboard.html", "permanent": false },
    { "source": "/user/", "destination": "/user/dashboard.html", "permanent": false },
    { "source": "/user/index.php", "destination": "/user/dashboard.html", "permanent": false },
    { "source": "/admin-dashboard.html", "destination": "/admin/index.html", "permanent": false },
    { "source": "/user-dashboard.html", "destination": "/user/dashboard.html", "permanent": false }
  ]
}
